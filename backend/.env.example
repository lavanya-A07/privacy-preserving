# MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=flyyy_privacy_platform

# Vault encryption (base64-encoded 32-byte key)
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_AES_KEY_BASE64=

# FPE encryption key (base64-encoded 32-byte key)
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FPE_KEY_BASE64=

# Token generation secret (base64-encoded 32-byte key)
TOKEN_SECRET_BASE64=

# Email (Mailpit / MailHog defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=privacy-shield@local

# App
APP_ENV=development
LOG_LEVEL=INFO